<Window x:Class="WebLab.RTR.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:WebLab.RTR.ViewModels"
        xmlns:views="clr-namespace:WebLab.RTR.Views"
        mc:Ignorable="d"
        Title="WebLab — Raqamli ta’lim resursi"
        Width="1320" Height="840"
        MinWidth="1080" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="{StaticResource BrushBackground}"
        FontFamily="{StaticResource FontPrimary}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="50"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      ResizeBorderThickness="6"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <!-- Optimized Hardware-Accelerated Entrance & Ambient Animations -->
    <Window.Resources>
        <Storyboard x:Key="EntranceStoryboard">
            <!-- Header bar fade-in -->
            <DoubleAnimation Storyboard.TargetName="HeaderBar"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.5">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <!-- Hero Left Typography Slide & Fade -->
            <DoubleAnimation Storyboard.TargetName="HeroContentGroup"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.7">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="HeroContentTransform"
                             Storyboard.TargetProperty="Y"
                             From="26" To="0" Duration="0:0:0.7">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <!-- Hero Right 2.5D Stage Entrance -->
            <DoubleAnimation Storyboard.TargetName="HeroVisualGroup"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.8">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="StageTranslate"
                             Storyboard.TargetProperty="Y"
                             From="32" To="0" Duration="0:0:0.8">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Storyboard x:Key="AmbientFloatingStoryboard" RepeatBehavior="Forever">
            <!-- 1. 3D Shaded Blue Sphere (Subtle gentle oscillation) -->
            <DoubleAnimation Storyboard.TargetName="SphereTransform"
                             Storyboard.TargetProperty="Y"
                             From="0" To="-8" Duration="0:0:3.8"
                             AutoReverse="True">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <!-- 2. HTML5 Glass Card (Gentle floating motion) -->
            <DoubleAnimation Storyboard.TargetName="HtmlCardTransform"
                             Storyboard.TargetProperty="Y"
                             From="0" To="-7" Duration="0:0:3.4"
                             AutoReverse="True">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <!-- 3. JavaScript Badge Card (Slight vertical drift) -->
            <DoubleAnimation Storyboard.TargetName="JsCardTransform"
                             Storyboard.TargetProperty="Y"
                             From="0" To="-8" Duration="0:0:3.6"
                             AutoReverse="True">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <!-- 4. UI Preview Card (Very subtle breathing) -->
            <DoubleAnimation Storyboard.TargetName="UiPreviewTransform"
                             Storyboard.TargetProperty="Y"
                             From="0" To="-5" Duration="0:0:4.2"
                             AutoReverse="True">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <!-- 5. CSS/Design Badge -->
            <DoubleAnimation Storyboard.TargetName="CssBadgeTransform"
                             Storyboard.TargetProperty="Y"
                             From="0" To="-6" Duration="0:0:3.2"
                             AutoReverse="True">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>

    <Grid MouseMove="OnMainWindowMouseMove" Background="{StaticResource BrushBackground}">
        <!-- ======================================================== -->
        <!-- PREMIUM LIGHT CLEAN SEAMLESS BACKGROUND                  -->
        <!-- Pure #F6F8FC base with smooth seamless corner gradients   -->
        <!-- 100% non-hit-testable (no blocking, no repeated patterns) -->
        <!-- ======================================================== -->
        <Grid IsHitTestVisible="False">
            <!-- Top-Right Smooth Subtle Radial Glow (Gradual fade into #F6F8FC) -->
            <Rectangle HorizontalAlignment="Right" VerticalAlignment="Top"
                       Width="850" Height="650"
                       Opacity="0.85">
                <Rectangle.Fill>
                    <RadialGradientBrush Center="1.0,0.0" GradientOrigin="1.0,0.0" RadiusX="1.0" RadiusY="1.0">
                        <GradientStop Color="#122563EB" Offset="0.0" />
                        <GradientStop Color="#0A3B82F6" Offset="0.45" />
                        <GradientStop Color="#0360A5FA" Offset="0.75" />
                        <GradientStop Color="#00F6F8FC" Offset="1.0" />
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- Bottom-Left Smooth Subtle Radial Glow (Gradual fade into #F6F8FC) -->
            <Rectangle HorizontalAlignment="Left" VerticalAlignment="Bottom"
                       Width="700" Height="550"
                       Opacity="0.75">
                <Rectangle.Fill>
                    <RadialGradientBrush Center="0.0,1.0" GradientOrigin="0.0,1.0" RadiusX="1.0" RadiusY="1.0">
                        <GradientStop Color="#0E06B6D4" Offset="0.0" />
                        <GradientStop Color="#0638BDF8" Offset="0.45" />
                        <GradientStop Color="#00F6F8FC" Offset="1.0" />
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- Single Minimal, Ultra-Low Contrast Edge Accent Line (Top-Right perimeter) -->
            <Path Stroke="#2563EB"
                  StrokeThickness="1"
                  Opacity="0.04"
                  Data="M 600,0 C 900,40 1150,150 1400,200" />
        </Grid>

        <!-- Main Window Layout Structure -->
        <Grid>
            <Grid.RowDefinitions>
                <!-- Title / Navigation Bar -->
                <RowDefinition Height="Auto" />
                <!-- Hero Central Workspace -->
                <RowDefinition Height="*" />
                <!-- Minimal Footer -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ========================================== -->
            <!-- A. APPLIKATSIYA SARLAVHASI (TITLE BAR)     -->
            <!-- ========================================== -->
            <Border x:Name="HeaderBar"
                    Grid.Row="0"
                    Background="{StaticResource BrushSurface}"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="0,0,0,1"
                    Height="58"
                    Panel.ZIndex="20">
                <Grid Margin="24,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- App Logo & Branding (Left) -->
                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                        <!-- Geometric Vector Logo -->
                        <Border Width="38" Height="38"
                                CornerRadius="10"
                                Margin="0,0,14,0"
                                Background="{StaticResource BrushPrimaryGradient}"
                                Effect="{StaticResource PrimaryGlowShadow}">
                            <Grid>
                                <!-- Code tag & diamond vector symbol -->
                                <Path HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Fill="#FFFFFF"
                                      Data="M 11,19 L 16,14 L 14.6,12.6 L 8.2,19 L 14.6,25.4 L 16,24 Z M 21,19 L 16,24 L 17.4,25.4 L 23.8,19 L 17.4,12.6 L 16,14 Z M 17.8,10 L 13.5,28 L 15.2,28 L 19.5,10 Z"
                                      RenderTransformOrigin="0.5,0.5">
                                    <Path.RenderTransform>
                                        <ScaleTransform ScaleX="0.88" ScaleY="0.88" />
                                    </Path.RenderTransform>
                                </Path>
                            </Grid>
                        </Border>

                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Web"
                                           FontSize="19"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource BrushTextPrimary}" />
                                <TextBlock Text="Lab"
                                           FontSize="19"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource BrushPrimary}" />
                            </StackPanel>
                            <TextBlock Text="RAQAMLI TA’LIM RESURSI"
                                       FontSize="9.5"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource BrushTextSecondary}"
                                       Margin="0,1,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Center Drag Area -->
                    <Grid Grid.Column="1" Background="Transparent" />

                    <!-- Window Control Buttons (Right) -->
                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Top"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                        <!-- Minimize Button -->
                        <Button Style="{StaticResource WindowControlButtonStyle}"
                                ToolTip="Kichraytirish"
                                Click="OnMinimizeWindowClick">
                            <Path Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                  StrokeThickness="1.4"
                                  Data="M 0,0 L 10,0"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Center" />
                        </Button>

                        <!-- Maximize / Restore Button -->
                        <Button Style="{StaticResource WindowControlButtonStyle}"
                                ToolTip="Kattalashtirish"
                                Click="OnMaximizeWindowClick">
                            <Path Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                  StrokeThickness="1.4"
                                  Data="M 0,0 L 10,0 L 10,10 L 0,10 Z"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Center" />
                        </Button>

                        <!-- Close Button -->
                        <Button Style="{StaticResource WindowCloseButtonStyle}"
                                ToolTip="Yopish"
                                Click="OnCloseWindowClick">
                            <Path Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                  StrokeThickness="1.4"
                                  Data="M 0,0 L 10,10 M 10,0 L 0,10"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Center" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ========================================== -->
            <!-- B. MARKAZIY HERO BO'LIMI (HOME VIEW)       -->
            <!-- ========================================== -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Focusable="False">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentView}" Value="Home">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>
                <Grid MaxWidth="1420"
                      Margin="52,24,52,24"
                      VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <!-- Left Column: Typography & CTAs (Balanced Proportion) -->
                        <ColumnDefinition Width="1.08*" />
                        <!-- Right Column: Prominent 2.5D Depth Visual Stage -->
                        <ColumnDefinition Width="1.18*" />
                    </Grid.ColumnDefinitions>

                    <!-- LEFT COLUMN: Matn va Ikkita asosiy navigatsiya tugmasi -->
                    <StackPanel x:Name="HeroContentGroup"
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Margin="0,0,38,0">
                        <StackPanel.RenderTransform>
                            <TranslateTransform x:Name="HeroContentTransform" Y="0" />
                        </StackPanel.RenderTransform>

                        <!-- Badge: Raqamli ta'lim resursi -->
                        <Border HorizontalAlignment="Left"
                                Background="{StaticResource BrushLightBlue}"
                                BorderBrush="#DCE7FD"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12,6"
                                Margin="0,0,0,22">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7"
                                         Fill="{StaticResource BrushPrimary}"
                                         Margin="0,0,8,0" />
                                <TextBlock Text="RAQAMLI TA’LIM RESURSI"
                                           FontSize="11.5"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource BrushPrimary}" />
                            </StackPanel>
                        </Border>

                        <!-- Asosiy Sarlavha: Veb dasturlash va dizayn -->
                        <TextBlock Text="Veb dasturlash va dizayn"
                                   FontSize="48"
                                   FontWeight="ExtraBold"
                                   Foreground="{StaticResource BrushTextPrimary}"
                                   TextWrapping="Wrap"
                                   LineHeight="56"
                                   Margin="0,0,0,22" />

                        <!-- Tavsif Matni -->
                        <TextBlock Text="Zamonaviy veb texnologiyalarni o‘rganing, ijodiy g‘oyalarni raqamli yechimlarga aylantiring va kelajak kasblariga tayyorlaning."
                                   FontSize="17"
                                   LineHeight="27"
                                   Foreground="{StaticResource BrushTextSecondary}"
                                   TextWrapping="Wrap"
                                   MaxWidth="590"
                                   HorizontalAlignment="Left"
                                   Margin="0,0,0,38" />

                        <!-- C. IKKITA ASOSIY TUGMA (Mavzular & Muallif) -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,42">
                            <!-- 1. Tugma: Mavzular -->
                            <Button Style="{StaticResource PrimaryHeroButtonStyle}"
                                    Command="{Binding NavigateToTopicsCommand}"
                                    Margin="0,0,18,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- Book/Catalog Vector Icon -->
                                    <Path Margin="0,0,12,0"
                                          Fill="#FFFFFF"
                                          VerticalAlignment="Center"
                                          Data="M 18,2 H 6 C 4.9,2 4,2.9 4,4 V 20 C 4,21.1 4.9,22 6,22 H 18 C 19.1,22 20,21.1 20,20 V 4 C 20,2.9 19.1,2 18,2 Z M 6,4 H 11 V 12 L 8.5,10.5 L 6,12 V 4 Z M 18,20 H 6 V 19 H 18 V 20 Z" />
                                    <TextBlock Text="Mavzular"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                    <!-- Arrow forward icon -->
                                    <Path Margin="10,1,0,0"
                                          Fill="#FFFFFF"
                                          Opacity="0.85"
                                          VerticalAlignment="Center"
                                          Data="M 5,12 H 19 M 13,6 L 19,12 L 13,18"
                                          Stroke="#FFFFFF"
                                          StrokeThickness="2" />
                                </StackPanel>
                            </Button>

                            <!-- 2. Tugma: Muallif -->
                            <Button Style="{StaticResource SecondaryHeroButtonStyle}"
                                    Command="{Binding NavigateToAuthorCommand}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- Author/User Vector Icon -->
                                    <Path Margin="0,0,12,0"
                                          Fill="{StaticResource BrushTextSecondary}"
                                          VerticalAlignment="Center"
                                          Data="M 12,12 C 14.21,12 16,10.21 16,8 C 16,5.79 14.21,4 12,4 C 9.79,4 8,5.79 8,8 C 8,10.21 9.79,12 12,12 Z M 12,14 C 9.33,14 4,15.34 4,18 V 20 H 20 V 18 C 20,15.34 14.67,14 12,14 Z" />
                                    <TextBlock Text="Muallif"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- D. QO'SHIMCHA VIZUAL ELEMENTLAR (Pillars & Tech badges) -->
                        <Border BorderBrush="{StaticResource BrushBorder}"
                                BorderThickness="0,1,0,0"
                                Padding="0,24,0,0"
                                MaxWidth="590"
                                HorizontalAlignment="Left">
                            <Grid Width="570">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Pillars -->
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                                    <TextBlock Text="NAZARIYA"
                                               FontSize="12.5"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource BrushNavy}" />
                                    <TextBlock Text=" • "
                                               FontSize="12.5"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource BrushPrimary}"
                                               Margin="5,0" />
                                    <TextBlock Text="AMALIYOT"
                                               FontSize="12.5"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource BrushNavy}" />
                                    <TextBlock Text=" • "
                                               FontSize="12.5"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource BrushPrimary}"
                                               Margin="5,0" />
                                    <TextBlock Text="IJOD"
                                               FontSize="12.5"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource BrushNavy}" />
                                </StackPanel>

                                <!-- Tech Badges -->
                                <WrapPanel Grid.Row="1" VerticalAlignment="Center">
                                    <!-- HTML5 Badge -->
                                    <Border Background="#FFF1EC"
                                            BorderBrush="#FED7AA"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="9,5"
                                            Margin="0,0,8,6">
                                        <TextBlock Text="&lt;/&gt; HTML5"
                                                   FontSize="11.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="#EA580C" />
                                    </Border>

                                    <!-- CSS3 Badge -->
                                    <Border Background="#EFF6FF"
                                            BorderBrush="#BFDBFE"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="9,5"
                                            Margin="0,0,8,6">
                                        <TextBlock Text="🎨 CSS3 &amp; Grid"
                                                   FontSize="11.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="#2563EB" />
                                    </Border>

                                    <!-- JS Badge -->
                                    <Border Background="#FEFCE8"
                                            BorderBrush="#FEF08A"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="9,5"
                                            Margin="0,0,8,6">
                                        <TextBlock Text="⚡ JavaScript ES6+"
                                                   FontSize="11.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="#CA8A04" />
                                    </Border>

                                    <!-- UI/UX Badge -->
                                    <Border Background="#FAF5FF"
                                            BorderBrush="#E9D5FF"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="9,5"
                                            Margin="0,0,8,6">
                                        <TextBlock Text="✨ UI/UX Dizayn"
                                                   FontSize="11.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="#9333EA" />
                                    </Border>
                                </WrapPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- ======================================================== -->
                    <!-- RIGHT COLUMN: EXPANDED 2.5D & 3D DEPTH VISUAL COMPOSITION -->
                    <!-- ======================================================== -->
                    <Grid x:Name="HeroVisualGroup"
                          Grid.Column="1"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Center"
                          Width="630" Height="530">
                        <!-- Stage Interactive Mouse Parallax Transform Group -->
                        <Grid.RenderTransform>
                            <TransformGroup>
                                <TranslateTransform x:Name="StageTranslate" X="0" Y="0" />
                                <RotateTransform x:Name="StageRotate" Angle="0" CenterX="315" CenterY="265" />
                            </TransformGroup>
                        </Grid.RenderTransform>

                        <!-- QATLAM 0: Soft 2.5D Isometric Backing Card & Architectural Plate -->
                        <Border Width="580" Height="470"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="{StaticResource BrushHeroGradient}"
                                BorderBrush="{StaticResource BrushBorder}"
                                BorderThickness="1.5"
                                CornerRadius="32"
                                Effect="{StaticResource FloatingShadow}" />

                        <!-- Decorative Modern Grid Pattern on Backing Plate -->
                        <Canvas IsHitTestVisible="False" Margin="36">
                            <!-- Subtle Tech Accent Dots -->
                            <Rectangle Width="5" Height="5" RadiusX="2.5" RadiusY="2.5" Fill="#93C5FD" Canvas.Top="18" Canvas.Left="24" />
                            <Rectangle Width="5" Height="5" RadiusX="2.5" RadiusY="2.5" Fill="#93C5FD" Canvas.Top="18" Canvas.Left="46" />
                            <Rectangle Width="5" Height="5" RadiusX="2.5" RadiusY="2.5" Fill="#93C5FD" Canvas.Top="40" Canvas.Left="24" />
                            <Rectangle Width="5" Height="5" RadiusX="2.5" RadiusY="2.5" Fill="#93C5FD" Canvas.Top="40" Canvas.Left="46" />

                            <Rectangle Width="5" Height="5" RadiusX="2.5" RadiusY="2.5" Fill="#93C5FD" Canvas.Bottom="24" Canvas.Right="40" />
                            <Rectangle Width="5" Height="5" RadiusX="2.5" RadiusY="2.5" Fill="#93C5FD" Canvas.Bottom="24" Canvas.Right="62" />
                            <Rectangle Width="5" Height="5" RadiusX="2.5" RadiusY="2.5" Fill="#93C5FD" Canvas.Bottom="46" Canvas.Right="40" />
                            <Rectangle Width="5" Height="5" RadiusX="2.5" RadiusY="2.5" Fill="#93C5FD" Canvas.Bottom="46" Canvas.Right="62" />

                            <!-- Geometric Isometric Cube / Hexagon Wireframe in Background -->
                            <Path Canvas.Top="38" Canvas.Right="44"
                                  Stroke="#BFDBFE"
                                  StrokeThickness="1.2"
                                  Opacity="0.6"
                                  Data="M 30,0 L 60,18 L 60,52 L 30,70 L 0,52 L 0,18 Z M 30,0 L 30,35 L 60,52 M 30,35 L 0,52" />
                        </Canvas>

                        <!-- QATLAM 1: Main 2.5D Angled Code Editor (Veb dasturlash yadrosi) -->
                        <Border x:Name="CodeEditorCard"
                                Width="440" Height="290"
                                VerticalAlignment="Top"
                                HorizontalAlignment="Left"
                                Margin="32,48,0,0"
                                Background="#0B1329"
                                BorderBrush="#1E293B"
                                BorderThickness="1.5"
                                CornerRadius="16"
                                Effect="{StaticResource Deep3DShadow}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <TransformGroup>
                                    <SkewTransform AngleX="-1.2" AngleY="1.4" />
                                    <TranslateTransform Y="0" />
                                </TransformGroup>
                            </Border.RenderTransform>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="36" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- Editor Titlebar with Traffic Lights & Active Tabs -->
                                <Border Grid.Row="0"
                                        Background="#162038"
                                        CornerRadius="15,15,0,0"
                                        Padding="14,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Traffic Lights -->
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="10" Height="10" Fill="#EF4444" Margin="0,0,6,0" />
                                            <Ellipse Width="10" Height="10" Fill="#F59E0B" Margin="0,0,6,0" />
                                            <Ellipse Width="10" Height="10" Fill="#10B981" />
                                        </StackPanel>

                                        <!-- Active File Tab -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Border Background="#0B1329"
                                                    CornerRadius="6,6,0,0"
                                                    Padding="12,5"
                                                    Margin="0,5,6,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="index.html"
                                                               FontSize="11"
                                                               FontFamily="{StaticResource FontCode}"
                                                               Foreground="#E2E8F0" />
                                                </StackPanel>
                                            </Border>
                                            <Border Background="Transparent"
                                                    Padding="10,5"
                                                    Margin="0,5,0,0">
                                                <TextBlock Text="style.css"
                                                           FontSize="11"
                                                           FontFamily="{StaticResource FontCode}"
                                                           Foreground="#64748B" />
                                            </Border>
                                        </StackPanel>

                                        <!-- Editor Tag / Mini Status -->
                                        <Border Grid.Column="2" Background="#1E293B" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                            <TextBlock Text="UTF-8" FontSize="9" FontFamily="{StaticResource FontCode}" Foreground="#94A3B8" />
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Code Body Syntax View -->
                                <StackPanel Grid.Row="1" Margin="16,14,16,12">
                                    <!-- Line 1 -->
                                    <StackPanel Orientation="Horizontal" Margin="0,2.5">
                                        <TextBlock Text="01 " FontFamily="{StaticResource FontCode}" FontSize="12" Foreground="#475569" Margin="0,0,10,0" />
                                        <TextBlock Text="&lt;" FontFamily="{StaticResource FontCode}" FontSize="12" Foreground="#64748B" />
                                        <TextBlock Text="section" FontFamily="{StaticResource FontCode}" FontSize="12" Foreground="#60A5FA" FontWeight="SemiBold" />
                                        <TextBlock Text=" class=" FontFamily="{StaticResource FontCode}" FontSize="12" Foreground="#94A3B8" />
                                        <TextBlock Text="&quot;weblab-hero&quot;" FontFamily="{StaticResource FontCode}" FontSize="12" Foreground="#34D399" />
                                        <TextBlock Text="&gt;" FontFamily="{StaticResource FontCode}" FontSize="12" Foreground="#64748B" />
                                    </StackPanel>

                                    <!-- Line 2 -->
                                    <StackPanel Orientation="Horizontal" Margin="0,2.5">
                                        <TextBlock Text="02 " FontFamily="{StaticResource FontCode}" FontSize="12" Foreground="#475569" Margin="0,0,10,0" />
                                        <TextBlock Text="    &lt;" FontFamily="{StaticResource FontCode}" FontSize="12" Foreground="#64748B" />
                                        <TextBlock Text="h1" FontFamily="{StaticResource FontCode}" FontSize="12" Foreground="#60A5FA" FontWeight="SemiBold" />
                                        <TextBlock Text="&gt;" FontFamily="{StaticResource FontCode}" FontSize="12" Foreground="#64748B" />
                                        <TextBlock Text="Veb dasturlash" FontFamily="{StaticResource FontCode}" FontSize="12" Foreground="#F8FAFC" />
                                        <TextBlock Text="&lt;/" FontFamily="{StaticResource FontCode}" FontSize="12" Foreground="#64748B" />
                                        <TextBlock Text="h1" FontFamily="{StaticResource FontCode}" FontSize="12" Foreground="#60A5FA" FontWeight="SemiBold" />
                                        <TextBlock Text="&gt;" FontFamily="{StaticResource FontCode}" FontSize="12" Foreground="#64748B" />
                                    </StackPanel>

                                    <!-- Line 3 -->
                                    <StackPanel Orientation="Horizontal" Margin="0,2.5">
                                        <TextBlock Text="03 " FontFamily="{StaticResource FontCode}" FontSize="12" Foreground="#475569" Margin="0,0,10,0" />
                                        <TextBlock Text="    &lt;" FontFamily="{StaticResource FontCode}" FontSize="12" Foreground="#64748B" />
                                        <TextBlock Text="div" FontFamily="{StaticResource FontCode}" FontSize="12" Foreground="#60A5FA" FontWeight="SemiBold" />
                                        <TextBlock Text=" class=" FontFamily="{StaticResource FontCode}" FontSize="12" Foreground="#94A3B8" />
                                        <TextBlock Text="&quot;modern-grid&quot;" FontFamily="{StaticResource FontCode}" FontSize="12" Foreground="#FCD34D" />
                                        <TextBlock Text="&gt;" FontFamily="{StaticResource FontCode}" FontSize="12" Foreground="#64748B" />
                                    </StackPanel>

                                    <!-- Line 4 -->
                                    <StackPanel Orientation="Horizontal" Margin="0,2.5">
                                        <TextBlock Text="04 " FontFamily="{StaticResource FontCode}" FontSize="12" Foreground="#475569" Margin="0,0,10,0" />
                                        <TextBlock Text="        &lt;" FontFamily="{StaticResource FontCode}" FontSize="12" Foreground="#64748B" />
                                        <TextBlock Text="button" FontFamily="{StaticResource FontCode}" FontSize="12" Foreground="#F472B6" FontWeight="SemiBold" />
                                        <TextBlock Text="&gt;" FontFamily="{StaticResource FontCode}" FontSize="12" Foreground="#64748B" />
                                        <TextBlock Text="Mavzular" FontFamily="{StaticResource FontCode}" FontSize="12" Foreground="#38BDF8" />
                                        <TextBlock Text="&lt;/" FontFamily="{StaticResource FontCode}" FontSize="12" Foreground="#64748B" />
                                        <TextBlock Text="button" FontFamily="{StaticResource FontCode}" FontSize="12" Foreground="#F472B6" FontWeight="SemiBold" />
                                        <TextBlock Text="&gt;" FontFamily="{StaticResource FontCode}" FontSize="12" Foreground="#64748B" />
                                    </StackPanel>

                                    <!-- Line 5 -->
                                    <StackPanel Orientation="Horizontal" Margin="0,2.5">
                                        <TextBlock Text="05 " FontFamily="{StaticResource FontCode}" FontSize="12" Foreground="#475569" Margin="0,0,10,0" />
                                        <TextBlock Text="    &lt;/" FontFamily="{StaticResource FontCode}" FontSize="12" Foreground="#64748B" />
                                        <TextBlock Text="div" FontFamily="{StaticResource FontCode}" FontSize="12" Foreground="#60A5FA" FontWeight="SemiBold" />
                                        <TextBlock Text="&gt;" FontFamily="{StaticResource FontCode}" FontSize="12" Foreground="#64748B" />
                                    </StackPanel>

                                    <!-- Status Bar inside editor -->
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Border Background="#162038" CornerRadius="4" Padding="7,3" Margin="0,0,8,0">
                                            <TextBlock Text="✔ Live Preview Active"
                                                       FontFamily="{StaticResource FontCode}"
                                                       FontSize="10.5"
                                                       Foreground="#10B981" />
                                        </Border>
                                        <Border Background="#162038" CornerRadius="4" Padding="7,3">
                                            <TextBlock Text="60 FPS"
                                                       FontFamily="{StaticResource FontCode}"
                                                       FontSize="10.5"
                                                       Foreground="#60A5FA" />
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- QATLAM 2: Hajmli 3D Shaded Blue Sphere (Yumshoq soyali ko‘k sfera) -->
                        <Border Width="64" Height="64"
                                VerticalAlignment="Top"
                                HorizontalAlignment="Right"
                                Margin="0,32,72,0"
                                CornerRadius="32"
                                Background="{StaticResource BrushSphere3D}"
                                Effect="{StaticResource SphereGlowShadow}">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="SphereTransform" Y="0" />
                            </Border.RenderTransform>
                            <!-- Specular Light Highlight Dot -->
                            <Ellipse Width="16" Height="10"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Top"
                                     Margin="14,10,0,0"
                                     Fill="#CCFFFFFF"
                                     Opacity="0.75" />
                        </Border>

                        <!-- QATLAM 3: Overlapping Live UI Result Card (Web Preview Glass Layer) -->
                        <Border x:Name="UiPreviewCard"
                                Width="290" Height="210"
                                VerticalAlignment="Bottom"
                                HorizontalAlignment="Right"
                                Margin="0,0,24,38"
                                Background="{StaticResource BrushSurface}"
                                BorderBrush="{StaticResource BrushBorder}"
                                BorderThickness="1.5"
                                CornerRadius="18"
                                Effect="{StaticResource Deep3DShadow}">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="UiPreviewTransform" Y="0" />
                            </Border.RenderTransform>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="34" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- Header Browser Tab -->
                                <Border Grid.Row="0"
                                        Background="#F8FAFC"
                                        BorderBrush="{StaticResource BrushBorder}"
                                        BorderThickness="0,0,0,1"
                                        CornerRadius="18,18,0,0"
                                        Padding="14,0">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="6" Height="6" Fill="#94A3B8" Margin="0,0,4,0" />
                                            <Ellipse Width="6" Height="6" Fill="#94A3B8" Margin="0,0,4,0" />
                                            <Ellipse Width="6" Height="6" Fill="#94A3B8" />
                                        </StackPanel>
                                        <!-- Mini Address Bar -->
                                        <Border HorizontalAlignment="Center"
                                                Background="#EDF2F7"
                                                CornerRadius="4"
                                                Padding="12,2"
                                                Height="20">
                                            <TextBlock Text="localhost:3000/preview"
                                                       FontSize="9.5"
                                                       FontFamily="{StaticResource FontCode}"
                                                       Foreground="{StaticResource BrushTextSecondary}"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- UI Render Preview Body -->
                                <StackPanel Grid.Row="1" Margin="16,14">
                                    <!-- Mini Hero elements mockup -->
                                    <Border Height="18" Width="140"
                                            Background="{StaticResource BrushLightBlue}"
                                            CornerRadius="5"
                                            HorizontalAlignment="Left"
                                            Margin="0,0,0,8" />
                                    <Border Height="8" Width="200"
                                            Background="#E2E8F0"
                                            CornerRadius="4"
                                            HorizontalAlignment="Left"
                                            Margin="0,0,0,6" />
                                    <Border Height="8" Width="150"
                                            Background="#E2E8F0"
                                            CornerRadius="4"
                                            HorizontalAlignment="Left"
                                            Margin="0,0,0,14" />

                                    <!-- Interactive buttons mockup -->
                                    <StackPanel Orientation="Horizontal">
                                        <Border Height="28" Width="82"
                                                Background="{StaticResource BrushPrimary}"
                                                CornerRadius="7"
                                                Margin="0,0,8,0">
                                            <TextBlock Text="WebLab"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       Foreground="#FFFFFF"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <Border Height="28" Width="72"
                                                Background="#F1F5F9"
                                                BorderBrush="#CBD5E1"
                                                BorderThickness="1"
                                                CornerRadius="7">
                                            <TextBlock Text="Dizayn"
                                                       FontSize="10.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="#475569"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- QATLAM 4: Suzib turgan HTML5 Glassmorphic karta (Pastki chap burchak) -->
                        <Border Width="155" Height="64"
                                VerticalAlignment="Bottom"
                                HorizontalAlignment="Left"
                                Margin="16,0,0,64"
                                Background="{StaticResource BrushGlassSurface}"
                                BorderBrush="{StaticResource BrushGlassBorder}"
                                BorderThickness="1.5"
                                CornerRadius="14"
                                Effect="{StaticResource FloatingShadow}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <TransformGroup>
                                    <RotateTransform Angle="-3.5" />
                                    <TranslateTransform x:Name="HtmlCardTransform" Y="0" />
                                </TransformGroup>
                            </Border.RenderTransform>
                            <Grid Margin="12,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="38" Height="38"
                                        Background="#FFF1EC"
                                        BorderBrush="#FED7AA"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="&lt;/&gt;"
                                               FontSize="15"
                                               FontWeight="ExtraBold"
                                               Foreground="#EA580C"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                    <TextBlock Text="HTML5 Semantika"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource BrushTextPrimary}" />
                                    <TextBlock Text="Tuzilma &amp; Tarkib"
                                               FontSize="10"
                                               Foreground="{StaticResource BrushTextSecondary}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- QATLAM 5: Suzib turgan JavaScript ES6+ Karta (Yuqori o‘ng burchak) -->
                        <Border Width="175" Height="58"
                                VerticalAlignment="Top"
                                HorizontalAlignment="Right"
                                Margin="0,118,12,0"
                                Background="{StaticResource BrushGlassSurface}"
                                BorderBrush="{StaticResource BrushGlassBorder}"
                                BorderThickness="1.5"
                                CornerRadius="14"
                                Effect="{StaticResource FloatingShadow}">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="JsCardTransform" Y="0" />
                            </Border.RenderTransform>
                            <Grid Margin="12,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="36" Height="36"
                                        Background="#FEFCE8"
                                        BorderBrush="#FEF08A"
                                        BorderThickness="1"
                                        CornerRadius="9"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="JS"
                                               FontSize="15"
                                               FontWeight="ExtraBold"
                                               Foreground="#CA8A04"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                    <TextBlock Text="JavaScript ES6+"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource BrushTextPrimary}" />
                                    <TextBlock Text="Interaktiv mantiq"
                                               FontSize="10"
                                               Foreground="{StaticResource BrushTextSecondary}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- QATLAM 6: Floating CSS3 & Dizayn Badge (Markaziy o‘rta) -->
                        <Border Width="160" Height="52"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Right"
                                Margin="0,0,0,76"
                                Background="{StaticResource BrushGlassSurface}"
                                BorderBrush="{StaticResource BrushGlassBorder}"
                                BorderThickness="1.5"
                                CornerRadius="12"
                                Effect="{StaticResource SoftCardShadow}">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="CssBadgeTransform" Y="0" />
                            </Border.RenderTransform>
                            <Grid Margin="10,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="32" Height="32"
                                        Background="{StaticResource BrushLightBlue}"
                                        BorderBrush="#BFDBFE"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="🎨"
                                               FontSize="15"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                    <TextBlock Text="CSS &amp; Flexbox"
                                               FontSize="11.5"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource BrushTextPrimary}" />
                                    <TextBlock Text="Vizual qoliplar"
                                               FontSize="9.5"
                                               Foreground="{StaticResource BrushTextSecondary}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- QATLAM 7: Shaffof shisha effektiga ega 2.5D Geometrik Prizma -->
                        <Border Width="50" Height="50"
                                VerticalAlignment="Bottom"
                                HorizontalAlignment="Center"
                                Margin="80,0,0,16"
                                Background="#E0FFFFFF"
                                BorderBrush="{StaticResource BrushGlassBorder}"
                                BorderThickness="1.5"
                                CornerRadius="14"
                                Effect="{StaticResource SoftCardShadow}">
                            <Border.RenderTransform>
                                <TransformGroup>
                                    <RotateTransform Angle="45" CenterX="25" CenterY="25" />
                                </TransformGroup>
                            </Border.RenderTransform>
                            <Grid>
                                <TextBlock Text="💎"
                                           FontSize="17"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center">
                                    <TextBlock.RenderTransform>
                                        <RotateTransform Angle="-45" CenterX="10" CenterY="10" />
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </ScrollViewer>

            <!-- ========================================== -->
            <!-- C. MAVZULAR SAHIFASI (TOPICS VIEW)         -->
            <!-- ========================================== -->
            <ContentControl Grid.Row="1"
                            Content="{Binding TopicsVM}">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentView}" Value="Topics">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
                <ContentControl.ContentTemplate>
                    <DataTemplate DataType="{x:Type vm:TopicsViewModel}">
                        <views:TopicsView />
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>

            <!-- ========================================== -->
            <!-- E. PASTKI QISM (FOOTER)                     -->
            <!-- ========================================== -->
            <Border Grid.Row="2"
                    Background="{StaticResource BrushSurface}"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="0,1,0,0"
                    Height="44">
                <Grid Margin="28,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="WebLab — Raqamli ta’lim resursi"
                               FontSize="12"
                               FontWeight="Medium"
                               Foreground="{StaticResource BrushTextSecondary}"
                               VerticalAlignment="Center" />

                    <TextBlock Grid.Column="1"
                               Text="«Veb dasturlash va dizayn» fani uchun maxsus ishlab chiqildi"
                               FontSize="11.5"
                               Foreground="#94A3B8"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Toast Notification Overlay for Upcoming Features -->
            <Border Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,32"
                    Background="#1E293B"
                    CornerRadius="12"
                    Padding="18,12"
                    Effect="{StaticResource FloatingShadow}"
                    Visibility="{Binding IsNotificationVisible, Converter={StaticResource BoolToVisConverter}}"
                    Panel.ZIndex="99">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="24" Height="24"
                            CornerRadius="12"
                            Background="{StaticResource BrushPrimary}"
                            Margin="0,0,12,0">
                        <TextBlock Text="ℹ"
                                   Foreground="#FFFFFF"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding NotificationSectionTitle}"
                                   FontWeight="Bold"
                                   FontSize="12.5"
                                   Foreground="#FFFFFF" />
                        <TextBlock Text="{Binding NotificationMessage}"
                                   FontSize="12"
                                   Foreground="#CBD5E1" />
                    </StackPanel>
                    <Button Content="✕"
                            Command="{Binding DismissNotificationCommand}"
                            Background="Transparent"
                            Foreground="#94A3B8"
                            BorderThickness="0"
                            FontSize="14"
                            FontWeight="Bold"
                            Cursor="Hand"
                            FocusVisualStyle="{x:Null}"
                            VerticalAlignment="Center"
                            Padding="4" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
