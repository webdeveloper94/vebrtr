<UserControl x:Class="WebLab.RTR.Views.PassportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:WebLab.RTR.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:PassportViewModel}"
             Background="Transparent">

    <Grid Margin="36,20,36,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Back Button -->
            <Button Grid.Column="0"
                    Command="{Binding BackToHomeCommand}"
                    Width="44" Height="44"
                    Margin="0,0,16,0"
                    Background="{StaticResource BrushSurface}"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="1.5"
                    Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Effect="{StaticResource SoftCardShadow}">
                            <Path HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Stroke="{StaticResource BrushTextPrimary}"
                                  StrokeThickness="2"
                                  Data="M 14,7 L 7,14 L 14,21 M 7,14 L 21,14" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource BrushLightBlue}" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="#93C5FD" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Raqamli ta’lim resursi (RTR) Pasporti"
                           FontSize="26"
                           FontWeight="ExtraBold"
                           Foreground="{StaticResource BrushTextPrimary}" />
                <TextBlock Text="Kasbiy ta’lim agentligi 153-sonli buyrug‘i talablari asosida shakllantirilgan rasmiy pasport"
                           FontSize="13.5"
                           Foreground="{StaticResource BrushTextSecondary}"
                           Margin="0,2,0,0" />
            </StackPanel>
        </Grid>

        <!-- CONTENT -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="1050" HorizontalAlignment="Left">
                
                <!-- CARD 1: MODUL HAQIDA ASOSIY MA'LUMOTLAR -->
                <Border Background="{StaticResource BrushSurface}"
                        BorderBrush="{StaticResource BrushBorder}"
                        BorderThickness="1.5"
                        CornerRadius="16"
                        Padding="26"
                        Margin="0,0,0,20"
                        Effect="{StaticResource SoftCardShadow}">
                    <StackPanel>
                        <TextBlock Text="1. Modul va Resurs haqida ma’lumot" FontSize="18" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,16" />
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Modul nomi:" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,10" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CourseName}" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,10" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Kasb / Mutaxassislik:" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,10" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ProfessionName}" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,10" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Modul identifikatori:" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,10" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ModuleCode}" Foreground="{StaticResource BrushPrimary}" FontWeight="Bold" Margin="0,0,0,10" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Ajratilgan soatlar:" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="Jami: 120 soat (Ma’ruza: 40 soat, Amaliyot: 60 soat, Mustaqil: 20 soat)" Foreground="{StaticResource BrushTextPrimary}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- CARD 2: O'QITISH NATIJALARI (SOXA EKSPERTI 10 BALL) -->
                <Border Background="{StaticResource BrushSurface}"
                        BorderBrush="{StaticResource BrushBorder}"
                        BorderThickness="1.5"
                        CornerRadius="16"
                        Padding="26"
                        Margin="0,0,0,20"
                        Effect="{StaticResource SoftCardShadow}">
                    <StackPanel>
                        <TextBlock Text="2. Modulning o‘qitish natijalari (Soha mezonlari)" FontSize="18" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,12" />
                        <TextBlock Text="{Binding LearningOutcomes}" FontSize="14.5" Foreground="#334155" LineHeight="24" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- CARD 3: MUALLIFLAR VA RESURS TALABLARI -->
                <Border Background="{StaticResource BrushSurface}"
                        BorderBrush="{StaticResource BrushBorder}"
                        BorderThickness="1.5"
                        CornerRadius="16"
                        Padding="26"
                        Margin="0,0,0,20"
                        Effect="{StaticResource SoftCardShadow}">
                    <StackPanel>
                        <TextBlock Text="3. Muallif(lar) va Texnik talablar" FontSize="18" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,12" />
                        <TextBlock Text="{Binding AuthorsInfo}" FontSize="14.5" Foreground="#334155" LineHeight="24" TextWrapping="Wrap" />
                        
                        <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,16,0,0">
                            <TextBlock Text="Resurs to‘liq yagona dasturiy mahsulot ko‘rinishida tuzilgan bo‘lib, hech qanday tarqoq fayllarsiz avtonom (oflayn) rejimda ishlash imkoniyatiga ega."
                                       FontSize="13" Foreground="#166534" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
