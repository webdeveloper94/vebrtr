<UserControl x:Class="WebLab.RTR.Views.TopicDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:WebLab.RTR.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:TopicDetailViewModel}"
             Background="Transparent">

    <Grid Margin="36,18,36,24">
        <Grid.RowDefinitions>
            <!-- 0: Top bar with Title & Navigation -->
            <RowDefinition Height="Auto" />
            <!-- 1: Main Workspace (Dashboard Cards OR Opened Resource Content) -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============================================== -->
        <!-- ROW 0: TOP BAR & TOPIC HEADER                  -->
        <!-- ============================================== -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Back Button -->
            <Button Grid.Column="0"
                    Command="{Binding BackToTopicsCommand}"
                    Width="44" Height="44"
                    Margin="0,0,16,0"
                    Background="{StaticResource BrushSurface}"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="1.5"
                    Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Effect="{StaticResource SoftCardShadow}">
                            <Path HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Stroke="{StaticResource BrushTextPrimary}"
                                  StrokeThickness="2"
                                  Data="M 14,7 L 7,14 L 14,21 M 7,14 L 21,14" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource BrushLightBlue}" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="#93C5FD" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Topic Title & Category -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Border Background="{StaticResource BrushLightBlue}"
                            BorderBrush="#BFDBFE"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="8,3"
                            Margin="0,0,10,0">
                        <TextBlock Text="{Binding Topic.Category, StringFormat='{}Modul: {0}'}"
                                   FontSize="12" FontWeight="Bold"
                                   Foreground="{StaticResource BrushPrimary}" />
                    </Border>
                    <Border Background="#F1F5F9"
                            CornerRadius="8"
                            Padding="8,3"
                            Margin="0,0,10,0">
                        <TextBlock Text="{Binding Topic.OrderNumber, StringFormat='{}{0}-Mavzu'}"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource BrushTextSecondary}" />
                    </Border>
                    <Border Background="#ECFDF5"
                            CornerRadius="8"
                            Padding="8,3">
                        <TextBlock Text="{Binding Topic.DurationMinutes, StringFormat='{}{0} daqiqa ajratilgan'}"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="#059669" />
                    </Border>
                </StackPanel>

                <TextBlock Text="{Binding Topic.Title}"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="{StaticResource BrushTextPrimary}"
                           Margin="0,6,0,0"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <!-- Status Badge -->
            <Border Grid.Column="2"
                    Background="{StaticResource BrushSurface}"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="1.5"
                    CornerRadius="12"
                    Padding="14,8"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="#10B981" Margin="0,0,8,0" />
                    <TextBlock Text="O‘quv moduli faol"
                               FontSize="12.5" FontWeight="Bold"
                               Foreground="#0F766E" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ============================================== -->
        <!-- ROW 1: WORKSPACE                               -->
        <!-- ============================================== -->
        <Grid Grid.Row="1">

            <!-- ========================================== -->
            <!-- 1. DASHBOARD: 6 TA INTERAKTIV RESURS KARTASI -->
            <!-- ========================================== -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentSubView}" Value="Dashboard">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>

                <StackPanel>
                    <TextBlock Text="Mavzuga biriktirilgan ta’lim resurslari to‘plami"
                               FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource BrushTextSecondary}"
                               Margin="0,0,0,18" />

                    <!-- Cards Grid (3x2 WrapPanel) -->
                    <WrapPanel Margin="-10,0,0,0">

                        <!-- CARD 1: MA'RUZA MATNI -->
                        <Button Command="{Binding OpenResourceCommand}" CommandParameter="Lecture"
                                Width="360" Height="220" Margin="10,0,10,20" Cursor="Hand" Background="Transparent" BorderThickness="0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="CardBorder" Background="{StaticResource BrushSurface}"
                                            BorderBrush="{StaticResource BrushBorder}" BorderThickness="1.5"
                                            CornerRadius="16" Padding="22" Effect="{StaticResource SoftCardShadow}">
                                        <Border.RenderTransform>
                                            <TranslateTransform x:Name="CardTrans" Y="0" />
                                        </Border.RenderTransform>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            
                                            <!-- Top Header with Icon and Badge -->
                                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="46" Height="46" CornerRadius="12" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" Margin="0,0,12,0">
                                                        <TextBlock Text="📑" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="1. Ma’ruza matni" FontSize="17.5" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" />
                                                        <TextBlock Text="Nazariya va amaliyot" FontSize="12" Foreground="{StaticResource BrushPrimary}" FontWeight="SemiBold" />
                                                    </StackPanel>
                                                </StackPanel>
                                                <Border Grid.Column="1" Background="#EFF6FF" CornerRadius="6" Padding="7,2" VerticalAlignment="Top">
                                                    <TextBlock Text="Nazariy" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushPrimary}" />
                                                </Border>
                                            </Grid>

                                            <TextBlock Grid.Row="1" Text="W3C xalqaro standartlari asosida tuzilgan to‘liq nazariy tushunchalar va amaliy mashg‘ulot topshiriqlari."
                                                       FontSize="13.5" Foreground="{StaticResource BrushTextSecondary}" TextWrapping="Wrap" LineHeight="20" />

                                            <Grid Grid.Row="2" Margin="0,8,0,0">
                                                <Border HorizontalAlignment="Left" Background="#F1F5F9" CornerRadius="6" Padding="6,2">
                                                    <TextBlock Text="Calibri 14pt" FontSize="11" Foreground="#64748B" />
                                                </Border>
                                                <TextBlock HorizontalAlignment="Right" Text="Ochish →" FontWeight="Bold" FontSize="13.5" Foreground="{StaticResource BrushPrimary}" VerticalAlignment="Center" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource BrushPrimary}" />
                                            <Setter TargetName="CardBorder" Property="Background" Value="#FBFDFF" />
                                            <Setter TargetName="CardBorder" Property="RenderTransform">
                                                <Setter.Value>
                                                    <TranslateTransform Y="-4" />
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- CARD 2: O'QITISH METODLARI -->
                        <Button Command="{Binding OpenResourceCommand}" CommandParameter="Methods"
                                Width="360" Height="220" Margin="10,0,10,20" Cursor="Hand" Background="Transparent" BorderThickness="0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="CardBorder" Background="{StaticResource BrushSurface}"
                                            BorderBrush="{StaticResource BrushBorder}" BorderThickness="1.5"
                                            CornerRadius="16" Padding="22" Effect="{StaticResource SoftCardShadow}">
                                        <Border.RenderTransform>
                                            <TranslateTransform x:Name="CardTrans" Y="0" />
                                        </Border.RenderTransform>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="46" Height="46" CornerRadius="12" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" Margin="0,0,12,0">
                                                        <TextBlock Text="🎯" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="2. O‘qitish metodlari" FontSize="17.5" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" />
                                                        <TextBlock Text="Pedagogik texnologiyalar" FontSize="12" Foreground="#166534" FontWeight="SemiBold" />
                                                    </StackPanel>
                                                </StackPanel>
                                                <Border Grid.Column="1" Background="#F0FDF4" CornerRadius="6" Padding="7,2" VerticalAlignment="Top">
                                                    <TextBlock Text="Interfaol" FontSize="11" FontWeight="Bold" Foreground="#166534" />
                                                </Border>
                                            </Grid>

                                            <TextBlock Grid.Row="1" Text="Keys-stadi, aqliy hujum, kichik guruhlarda ishlash va interfaol o‘qitish uslublari tavsiyalari."
                                                       FontSize="13.5" Foreground="{StaticResource BrushTextSecondary}" TextWrapping="Wrap" LineHeight="20" />

                                            <Grid Grid.Row="2" Margin="0,8,0,0">
                                                <Border HorizontalAlignment="Left" Background="#F1F5F9" CornerRadius="6" Padding="6,2">
                                                    <TextBlock Text="Keys-stadi" FontSize="11" Foreground="#64748B" />
                                                </Border>
                                                <TextBlock HorizontalAlignment="Right" Text="Ochish →" FontWeight="Bold" FontSize="13.5" Foreground="#166534" VerticalAlignment="Center" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="CardBorder" Property="BorderBrush" Value="#10B981" />
                                            <Setter TargetName="CardBorder" Property="Background" Value="#FBFDFF" />
                                            <Setter TargetName="CardBorder" Property="RenderTransform">
                                                <Setter.Value>
                                                    <TranslateTransform Y="-4" />
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- CARD 3: MEDIA VA VIDEO -->
                        <Button Command="{Binding OpenResourceCommand}" CommandParameter="Video"
                                Width="360" Height="220" Margin="10,0,10,20" Cursor="Hand" Background="Transparent" BorderThickness="0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="CardBorder" Background="{StaticResource BrushSurface}"
                                            BorderBrush="{StaticResource BrushBorder}" BorderThickness="1.5"
                                            CornerRadius="16" Padding="22" Effect="{StaticResource SoftCardShadow}">
                                        <Border.RenderTransform>
                                            <TranslateTransform x:Name="CardTrans" Y="0" />
                                        </Border.RenderTransform>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="46" Height="46" CornerRadius="12" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" Margin="0,0,12,0">
                                                        <TextBlock Text="🎥" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="3. Media &amp; Video" FontSize="17.5" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" />
                                                        <TextBlock Text="Full HD video darslik" FontSize="12" Foreground="#DC2626" FontWeight="SemiBold" />
                                                    </StackPanel>
                                                </StackPanel>
                                                <Border Grid.Column="1" Background="#FEF2F2" CornerRadius="6" Padding="7,2" VerticalAlignment="Top">
                                                    <TextBlock Text="1080p" FontSize="11" FontWeight="Bold" Foreground="#DC2626" />
                                                </Border>
                                            </Grid>

                                            <TextBlock Grid.Row="1" Text="Mavzuning vizual tushuntirilishi, amaliy kod yozish jarayoni va ovozli yo‘riqnoma."
                                                       FontSize="13.5" Foreground="{StaticResource BrushTextSecondary}" TextWrapping="Wrap" LineHeight="20" />

                                            <Grid Grid.Row="2" Margin="0,8,0,0">
                                                <Border HorizontalAlignment="Left" Background="#F1F5F9" CornerRadius="6" Padding="6,2">
                                                    <TextBlock Text="{Binding Topic.VideoDuration, StringFormat='{}Davomiyligi: {0}'}" FontSize="11" Foreground="#64748B" />
                                                </Border>
                                                <TextBlock HorizontalAlignment="Right" Text="Ochish →" FontWeight="Bold" FontSize="13.5" Foreground="#DC2626" VerticalAlignment="Center" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="CardBorder" Property="BorderBrush" Value="#EF4444" />
                                            <Setter TargetName="CardBorder" Property="Background" Value="#FBFDFF" />
                                            <Setter TargetName="CardBorder" Property="RenderTransform">
                                                <Setter.Value>
                                                    <TranslateTransform Y="-4" />
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- CARD 4: TAQDIMOT MATERIALLARI -->
                        <Button Command="{Binding OpenResourceCommand}" CommandParameter="Presentation"
                                Width="360" Height="220" Margin="10,0,10,20" Cursor="Hand" Background="Transparent" BorderThickness="0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="CardBorder" Background="{StaticResource BrushSurface}"
                                            BorderBrush="{StaticResource BrushBorder}" BorderThickness="1.5"
                                            CornerRadius="16" Padding="22" Effect="{StaticResource SoftCardShadow}">
                                        <Border.RenderTransform>
                                            <TranslateTransform x:Name="CardTrans" Y="0" />
                                        </Border.RenderTransform>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="46" Height="46" CornerRadius="12" Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" Margin="0,0,12,0">
                                                        <TextBlock Text="📊" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="4. Taqdimot (PPT)" FontSize="17.5" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" />
                                                        <TextBlock Text="Ko‘rgazmali slaydlar" FontSize="12" Foreground="#D97706" FontWeight="SemiBold" />
                                                    </StackPanel>
                                                </StackPanel>
                                                <Border Grid.Column="1" Background="#FFFBEB" CornerRadius="6" Padding="7,2" VerticalAlignment="Top">
                                                    <TextBlock Text="PPTX" FontSize="11" FontWeight="Bold" Foreground="#D97706" />
                                                </Border>
                                            </Grid>

                                            <TextBlock Grid.Row="1" Text="Dars davomida proyektor yoki monitorda ko‘rsatish uchun tayyorlangan ko‘rgazmali infografika va slaydlar."
                                                       FontSize="13.5" Foreground="{StaticResource BrushTextSecondary}" TextWrapping="Wrap" LineHeight="20" />

                                            <Grid Grid.Row="2" Margin="0,8,0,0">
                                                <Border HorizontalAlignment="Left" Background="#F1F5F9" CornerRadius="6" Padding="6,2">
                                                    <TextBlock Text="{Binding Topic.PresentationSlideCount, StringFormat='{}{0} ta slayd'}" FontSize="11" Foreground="#64748B" />
                                                </Border>
                                                <TextBlock HorizontalAlignment="Right" Text="Ochish →" FontWeight="Bold" FontSize="13.5" Foreground="#D97706" VerticalAlignment="Center" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="CardBorder" Property="BorderBrush" Value="#F59E0B" />
                                            <Setter TargetName="CardBorder" Property="Background" Value="#FBFDFF" />
                                            <Setter TargetName="CardBorder" Property="RenderTransform">
                                                <Setter.Value>
                                                    <TranslateTransform Y="-4" />
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- CARD 5: BAHOLASH VA TESTLAR -->
                        <Button Command="{Binding OpenResourceCommand}" CommandParameter="Assessment"
                                Width="360" Height="220" Margin="10,0,10,20" Cursor="Hand" Background="Transparent" BorderThickness="0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="CardBorder" Background="{StaticResource BrushSurface}"
                                            BorderBrush="{StaticResource BrushBorder}" BorderThickness="1.5"
                                            CornerRadius="16" Padding="22" Effect="{StaticResource SoftCardShadow}">
                                        <Border.RenderTransform>
                                            <TranslateTransform x:Name="CardTrans" Y="0" />
                                        </Border.RenderTransform>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="46" Height="46" CornerRadius="12" Background="#F5F3FF" BorderBrush="#DDD6FE" BorderThickness="1" Margin="0,0,12,0">
                                                        <TextBlock Text="📝" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="5. Baholash &amp; Test" FontSize="17.5" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" />
                                                        <TextBlock Text="Interaktiv nazorat" FontSize="12" Foreground="#7C3AED" FontWeight="SemiBold" />
                                                    </StackPanel>
                                                </StackPanel>
                                                <Border Grid.Column="1" Background="#F5F3FF" CornerRadius="6" Padding="7,2" VerticalAlignment="Top">
                                                    <TextBlock Text="Test" FontSize="11" FontWeight="Bold" Foreground="#7C3AED" />
                                                </Border>
                                            </Grid>

                                            <TextBlock Grid.Row="1" Text="Mavzuni mustahkamlash savollari, javobi darhol tekshiriluvchi interaktiv testlar va topshiriqlar."
                                                       FontSize="13.5" Foreground="{StaticResource BrushTextSecondary}" TextWrapping="Wrap" LineHeight="20" />

                                            <Grid Grid.Row="2" Margin="0,8,0,0">
                                                <Border HorizontalAlignment="Left" Background="#F1F5F9" CornerRadius="6" Padding="6,2">
                                                    <TextBlock Text="Jonli tekshiruv" FontSize="11" Foreground="#64748B" />
                                                </Border>
                                                <TextBlock HorizontalAlignment="Right" Text="Ochish →" FontWeight="Bold" FontSize="13.5" Foreground="#7C3AED" VerticalAlignment="Center" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="CardBorder" Property="BorderBrush" Value="#8B5CF6" />
                                            <Setter TargetName="CardBorder" Property="Background" Value="#FBFDFF" />
                                            <Setter TargetName="CardBorder" Property="RenderTransform">
                                                <Setter.Value>
                                                    <TranslateTransform Y="-4" />
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- CARD 6: GLOSSARIY (ATAMALAR LUG'ATI) -->
                        <Button Command="{Binding OpenResourceCommand}" CommandParameter="Glossary"
                                Width="360" Height="220" Margin="10,0,10,20" Cursor="Hand" Background="Transparent" BorderThickness="0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="CardBorder" Background="{StaticResource BrushSurface}"
                                            BorderBrush="{StaticResource BrushBorder}" BorderThickness="1.5"
                                            CornerRadius="16" Padding="22" Effect="{StaticResource SoftCardShadow}">
                                        <Border.RenderTransform>
                                            <TranslateTransform x:Name="CardTrans" Y="0" />
                                        </Border.RenderTransform>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="46" Height="46" CornerRadius="12" Background="#ECFEFF" BorderBrush="#A5F3FC" BorderThickness="1" Margin="0,0,12,0">
                                                        <TextBlock Text="📖" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="6. Glossariy" FontSize="17.5" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" />
                                                        <TextBlock Text="Mavzuga oid atamalar" FontSize="12" Foreground="#0891B2" FontWeight="SemiBold" />
                                                    </StackPanel>
                                                </StackPanel>
                                                <Border Grid.Column="1" Background="#ECFEFF" CornerRadius="6" Padding="7,2" VerticalAlignment="Top">
                                                    <TextBlock Text="Lug‘at" FontSize="11" FontWeight="Bold" Foreground="#0891B2" />
                                                </Border>
                                            </Grid>

                                            <TextBlock Grid.Row="1" Text="Mazkur darsda uchraydigan texnik atamalar, kalit so‘zlar va ularning batafsil sohaviy izohlari."
                                                       FontSize="13.5" Foreground="{StaticResource BrushTextSecondary}" TextWrapping="Wrap" LineHeight="20" />

                                            <Grid Grid.Row="2" Margin="0,8,0,0">
                                                <Border HorizontalAlignment="Left" Background="#F1F5F9" CornerRadius="6" Padding="6,2">
                                                    <TextBlock Text="Izohli atamalar" FontSize="11" Foreground="#64748B" />
                                                </Border>
                                                <TextBlock HorizontalAlignment="Right" Text="Ochish →" FontWeight="Bold" FontSize="13.5" Foreground="#0891B2" VerticalAlignment="Center" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="CardBorder" Property="BorderBrush" Value="#06B6D4" />
                                            <Setter TargetName="CardBorder" Property="Background" Value="#FBFDFF" />
                                            <Setter TargetName="CardBorder" Property="RenderTransform">
                                                <Setter.Value>
                                                    <TranslateTransform Y="-4" />
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </WrapPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- ========================================== -->
            <!-- 2. RESURS BATAFSIL EKRANI (OCHILGANDA)     -->
            <!-- ========================================== -->
            <Border Background="{StaticResource BrushSurface}"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="1.5"
                    CornerRadius="16"
                    Padding="28"
                    Effect="{StaticResource SoftCardShadow}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentSubView}" Value="Dashboard">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Top Action Bar (Back button, Reader mode font controls) -->
                        <RowDefinition Height="Auto" />
                        <!-- Content ScrollViewer -->
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Resource Header & Action Bar -->
                    <Grid Grid.Row="0" Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Back to Dashboard -->
                        <Button Grid.Column="0"
                                Command="{Binding BackToDashboardCommand}"
                                Height="38" Padding="14,0" Margin="0,0,16,0"
                                Background="{StaticResource BrushLightBlue}"
                                BorderBrush="#BFDBFE" BorderThickness="1"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="10">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="←" FontWeight="Bold" FontSize="15" Foreground="{StaticResource BrushPrimary}" Margin="0,0,8,0" />
                                            <TextBlock Text="Barcha resurslarga qaytish" FontWeight="Bold" FontSize="13" Foreground="{StaticResource BrushPrimary}" />
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Reader Mode Font Controls (Ko'rsatish faqat Ma'ruza ochilganda) -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentSubView}" Value="Lecture">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <Border Background="#F1F5F9" CornerRadius="10" Padding="4" BorderBrush="#E2E8F0" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Shrift:" FontSize="12" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center" Margin="8,0,6,0" />
                                    <!-- A- -->
                                    <Button Command="{Binding DecreaseFontSizeCommand}"
                                            Content="A−" Width="30" Height="28" FontWeight="Bold" FontSize="12"
                                            Background="White" BorderBrush="#CBD5E1" BorderThickness="1" Margin="2,0" Cursor="Hand" />
                                    <!-- Reset -->
                                    <Button Command="{Binding ResetFontSizeCommand}"
                                            Content="100%" Width="44" Height="28" FontSize="11.5"
                                            Background="White" BorderBrush="#CBD5E1" BorderThickness="1" Margin="2,0" Cursor="Hand" />
                                    <!-- A+ -->
                                    <Button Command="{Binding IncreaseFontSizeCommand}"
                                            Content="A+" Width="30" Height="28" FontWeight="Bold" FontSize="12"
                                            Background="White" BorderBrush="#CBD5E1" BorderThickness="1" Margin="2,0" Cursor="Hand" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- CONTENT VIEWS -->
                    <Grid Grid.Row="1">
                        
                        <!-- 1. MA'RUZA MATNI -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ScrollViewer.Style>
                                <Style TargetType="ScrollViewer">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentSubView}" Value="Lecture">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ScrollViewer.Style>

                            <StackPanel MaxWidth="960" HorizontalAlignment="Left">
                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,20">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="ℹ️" FontSize="15" Margin="0,0,8,0" />
                                        <TextBlock Text="Dars matni: Calibri 14pt, oraliq 1.0, o‘quv dasturiga muvofiq shakllantirilgan."
                                                   FontSize="12.5" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="Nazariy asoslar" FontSize="22" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,12" />
                                <TextBlock Text="{Binding Topic.LectureContent}"
                                           FontFamily="Calibri, Segoe UI"
                                           FontSize="{Binding LectureFontSize}"
                                           LineHeight="26"
                                           Foreground="#334155"
                                           TextWrapping="Wrap" />

                                <Separator Margin="0,28" Background="{StaticResource BrushBorder}" />

                                <TextBlock Text="Amaliy topshiriq va mashg‘ulot" FontSize="22" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,12" />
                                <TextBlock Text="{Binding Topic.PracticalTasks}"
                                           FontFamily="Calibri, Segoe UI"
                                           FontSize="{Binding LectureFontSize}"
                                           LineHeight="26"
                                           Foreground="#334155"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </ScrollViewer>

                        <!-- 2. O'QITISH METODLARI -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ScrollViewer.Style>
                                <Style TargetType="ScrollViewer">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentSubView}" Value="Methods">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ScrollViewer.Style>

                            <StackPanel MaxWidth="960" HorizontalAlignment="Left">
                                <TextBlock Text="Mavzuda qo‘llaniladigan pedagogik va interfaol metodlar" FontSize="22" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,16" />
                                
                                <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1.5" CornerRadius="14" Padding="22" Margin="0,0,0,20">
                                    <StackPanel>
                                        <TextBlock Text="Tavsiya etilgan metod:" FontWeight="Bold" FontSize="17" Foreground="#166534" Margin="0,0,0,8" />
                                        <TextBlock Text="{Binding Topic.TeachingMethods}" FontSize="15" Foreground="#14532D" TextWrapping="Wrap" LineHeight="24" />
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="Metodning ta’limdagi ahamiyati:" FontWeight="Bold" FontSize="16" Foreground="{StaticResource BrushTextPrimary}" Margin="0,8,0,8" />
                                <TextBlock Text="Ushbu metod orqali o‘quvchilar passiv tinglovchidan faol ishtirokchiga aylanadi. Nazariy bilimlarni real amaliy vaziyatlar, kod yozish va jamoaviy muhokamalarda sinab ko‘rish orqali kasbiy ko‘nikmalar mustahkamlanadi."
                                           FontSize="14.5" Foreground="{StaticResource BrushTextSecondary}" TextWrapping="Wrap" LineHeight="22" />
                            </StackPanel>
                        </ScrollViewer>

                        <!-- 3. MEDIA VA VIDEO (Zamonaviy Player UI) -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ScrollViewer.Style>
                                <Style TargetType="ScrollViewer">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentSubView}" Value="Video">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ScrollViewer.Style>

                            <StackPanel MaxWidth="960" HorizontalAlignment="Left">
                                <TextBlock Text="Video darslik va multimedia materiallari" FontSize="22" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,16" />

                                <!-- Professional Video Mockup Player -->
                                <Border Height="380" Background="#0A0F1D" CornerRadius="16" Margin="0,0,0,20" Effect="{StaticResource FloatingShadow}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Player Top Bar -->
                                        <Grid Grid.Row="0" Margin="18,14">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Background="#2563EB" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                    <TextBlock Text="1080p FULL HD" FontWeight="Bold" FontSize="10" Foreground="White" />
                                                </Border>
                                                <TextBlock Text="{Binding Topic.Title, StringFormat='{}Video dars: {0}'}" FontSize="13" Foreground="#94A3B8" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- Player Center Play Button -->
                                        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <Border Width="68" Height="68" CornerRadius="34" Background="{StaticResource BrushPrimary}" Margin="0,0,0,12" Cursor="Hand">
                                                <Path Data="M 8,5 L 19,12 L 8,19 Z" Fill="White" Stretch="Uniform" Width="22" Height="22" Margin="4,0,0,0" />
                                            </Border>
                                            <TextBlock Text="Videoni ijro etish" FontSize="16" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" />
                                        </StackPanel>

                                        <!-- Player Bottom Controls Bar -->
                                        <Border Grid.Row="2" Background="#141B2D" CornerRadius="0,0,16,16" Padding="18,12">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <!-- Progress Bar -->
                                                <ProgressBar Grid.Row="0" Value="35" Maximum="100" Height="4" Foreground="#2563EB" Background="#334155" BorderThickness="0" Margin="0,0,0,10" />

                                                <!-- Bottom Bar Controls -->
                                                <Grid Grid.Row="1">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                                        <TextBlock Text="▶  " FontSize="13" Foreground="White" />
                                                        <TextBlock Text="04:25 / 15:00" FontSize="12" Foreground="#94A3B8" />
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                        <Border Background="#1E293B" CornerRadius="4" Padding="6,2" Margin="0,0,10,0">
                                                            <TextBlock Text="1.0x" FontSize="11" Foreground="#CBD5E1" />
                                                        </Border>
                                                        <TextBlock Text="⛶ To‘liq ekran" FontSize="12" Foreground="#94A3B8" />
                                                    </StackPanel>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Taymkodlar (Dars bo'limlari) -->
                                <Border Background="#F8FAFC" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1.5" CornerRadius="14" Padding="18">
                                    <StackPanel>
                                        <TextBlock Text="📌 Video dars mundarijasi (taymkodlar):" FontWeight="Bold" FontSize="15" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,10" />
                                        <TextBlock Text="00:00 — Mavzuga kirish va asosiy maqsad" FontSize="13.5" Foreground="#475569" Margin="0,0,0,4" />
                                        <TextBlock Text="03:15 — Asosiy tushunchalar va qoidalar" FontSize="13.5" Foreground="#475569" Margin="0,0,0,4" />
                                        <TextBlock Text="08:40 — Amaliy kod yozish va xatolarni tahlil qilish" FontSize="13.5" Foreground="#475569" Margin="0,0,0,4" />
                                        <TextBlock Text="13:20 — Xulosa va mustaqil topshiriq yo‘riqnomasi" FontSize="13.5" Foreground="#475569" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- 4. TAQDIMOT MATERIALLARI -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ScrollViewer.Style>
                                <Style TargetType="ScrollViewer">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentSubView}" Value="Presentation">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ScrollViewer.Style>

                            <StackPanel MaxWidth="960" HorizontalAlignment="Left">
                                <TextBlock Text="Mavzuga oid taqdimot va ko‘rgazmali vositalar" FontSize="22" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,16" />

                                <Border Background="#F8FAFC" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1.5" CornerRadius="16" Padding="24" Margin="0,0,0,20">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Width="64" Height="64" CornerRadius="14" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" Margin="0,0,20,0">
                                            <TextBlock Text="PPTX" FontSize="16" FontWeight="ExtraBold" Foreground="#DC2626" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Topic.Title, StringFormat='{}{0} — Taqdimot slaydlari'}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" />
                                            <TextBlock Text="{Binding Topic.PresentationSlideCount, StringFormat='{}Slaydlar soni: {0} ta | Formati: PPTX, PDF'}" FontSize="13" Foreground="{StaticResource BrushTextSecondary}" Margin="0,4,0,0" />
                                        </StackPanel>

                                        <Border Grid.Column="2" Background="{StaticResource BrushLightBlue}" CornerRadius="10" Padding="14,10" VerticalAlignment="Center">
                                            <TextBlock Text="Taqdimot tayyor" FontWeight="Bold" Foreground="{StaticResource BrushPrimary}" FontSize="13" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- 5. BAHOLASH VA INTERAKTIV TESTLAR -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ScrollViewer.Style>
                                <Style TargetType="ScrollViewer">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentSubView}" Value="Assessment">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ScrollViewer.Style>

                            <StackPanel MaxWidth="960" HorizontalAlignment="Left">
                                <TextBlock Text="Nazorat savollari va o‘z-o‘zini baholash testlari" FontSize="22" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,16" />

                                <ItemsControl ItemsSource="{Binding Questions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#F8FAFC" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1.5" CornerRadius="14" Padding="22" Margin="0,0,0,18">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding QuestionText}" FontSize="16.5" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,16" TextWrapping="Wrap" />

                                                    <!-- 4 Options with RadioButton Behavior -->
                                                    <StackPanel Margin="0,0,0,14">
                                                        <!-- Option A -->
                                                        <RadioButton GroupName="{Binding Id}" Margin="0,0,0,8" Cursor="Hand"
                                                                     IsChecked="{Binding SelectedOptionIndex, Converter={x:Null}}">
                                                            <RadioButton.Template>
                                                                <ControlTemplate TargetType="RadioButton">
                                                                    <Border x:Name="optBorder" Background="White" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1.5" CornerRadius="10" Padding="14,10">
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="Auto" />
                                                                                <ColumnDefinition Width="*" />
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock Text="A" FontWeight="Bold" Foreground="{StaticResource BrushPrimary}" Margin="0,0,12,0" />
                                                                            <TextBlock Grid.Column="1" Text="{Binding OptionA}" FontSize="14" Foreground="#334155" />
                                                                        </Grid>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <DataTrigger Binding="{Binding SelectedOptionIndex}" Value="0">
                                                                            <Setter TargetName="optBorder" Property="Background" Value="#EFF6FF" />
                                                                            <Setter TargetName="optBorder" Property="BorderBrush" Value="#3B82F6" />
                                                                        </DataTrigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </RadioButton.Template>
                                                        </RadioButton>

                                                        <!-- Option B -->
                                                        <RadioButton GroupName="{Binding Id}" Margin="0,0,0,8" Cursor="Hand">
                                                            <RadioButton.Template>
                                                                <ControlTemplate TargetType="RadioButton">
                                                                    <Border x:Name="optBorder" Background="White" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1.5" CornerRadius="10" Padding="14,10">
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="Auto" />
                                                                                <ColumnDefinition Width="*" />
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock Text="B" FontWeight="Bold" Foreground="{StaticResource BrushPrimary}" Margin="0,0,12,0" />
                                                                            <TextBlock Grid.Column="1" Text="{Binding OptionB}" FontSize="14" Foreground="#334155" />
                                                                        </Grid>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <DataTrigger Binding="{Binding SelectedOptionIndex}" Value="1">
                                                                            <Setter TargetName="optBorder" Property="Background" Value="#EFF6FF" />
                                                                            <Setter TargetName="optBorder" Property="BorderBrush" Value="#3B82F6" />
                                                                        </DataTrigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </RadioButton.Template>
                                                        </RadioButton>

                                                        <!-- Option C -->
                                                        <RadioButton GroupName="{Binding Id}" Margin="0,0,0,8" Cursor="Hand">
                                                            <RadioButton.Template>
                                                                <ControlTemplate TargetType="RadioButton">
                                                                    <Border x:Name="optBorder" Background="White" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1.5" CornerRadius="10" Padding="14,10">
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="Auto" />
                                                                                <ColumnDefinition Width="*" />
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock Text="C" FontWeight="Bold" Foreground="{StaticResource BrushPrimary}" Margin="0,0,12,0" />
                                                                            <TextBlock Grid.Column="1" Text="{Binding OptionC}" FontSize="14" Foreground="#334155" />
                                                                        </Grid>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <DataTrigger Binding="{Binding SelectedOptionIndex}" Value="2">
                                                                            <Setter TargetName="optBorder" Property="Background" Value="#EFF6FF" />
                                                                            <Setter TargetName="optBorder" Property="BorderBrush" Value="#3B82F6" />
                                                                        </DataTrigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </RadioButton.Template>
                                                        </RadioButton>

                                                        <!-- Option D -->
                                                        <RadioButton GroupName="{Binding Id}" Margin="0,0,0,8" Cursor="Hand">
                                                            <RadioButton.Template>
                                                                <ControlTemplate TargetType="RadioButton">
                                                                    <Border x:Name="optBorder" Background="White" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1.5" CornerRadius="10" Padding="14,10">
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="Auto" />
                                                                                <ColumnDefinition Width="*" />
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock Text="D" FontWeight="Bold" Foreground="{StaticResource BrushPrimary}" Margin="0,0,12,0" />
                                                                            <TextBlock Grid.Column="1" Text="{Binding OptionD}" FontSize="14" Foreground="#334155" />
                                                                        </Grid>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <DataTrigger Binding="{Binding SelectedOptionIndex}" Value="3">
                                                                            <Setter TargetName="optBorder" Property="Background" Value="#EFF6FF" />
                                                                            <Setter TargetName="optBorder" Property="BorderBrush" Value="#3B82F6" />
                                                                        </DataTrigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </RadioButton.Template>
                                                        </RadioButton>
                                                    </StackPanel>

                                                    <!-- Check Answer Button & Explanation -->
                                                    <Border Background="#F0FDF4" CornerRadius="10" Padding="14" Margin="0,4,0,0">
                                                        <StackPanel>
                                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                                <TextBlock Text="To‘g‘ri javob: " FontWeight="Bold" FontSize="13" Foreground="#166534" />
                                                                <TextBlock Text="A varianti" FontWeight="Bold" FontSize="13" Foreground="#15803D" />
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding Explanation, StringFormat='{}💡 Izoh: {0}'}" FontSize="13" Foreground="#166534" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- 6. GLOSSARIY (ATAMALAR LUG'ATI) -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ScrollViewer.Style>
                                <Style TargetType="ScrollViewer">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentSubView}" Value="Glossary">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ScrollViewer.Style>

                            <StackPanel MaxWidth="960" HorizontalAlignment="Left">
                                <TextBlock Text="Mavzuga doir sohaviy atamalar va izohli lug‘at" FontSize="22" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,16" />

                                <Border Background="#ECFEFF" BorderBrush="#A5F3FC" BorderThickness="1.5" CornerRadius="14" Padding="22" Margin="0,0,0,20">
                                    <StackPanel>
                                        <TextBlock Text="Mavzu atamalari:" FontWeight="Bold" FontSize="17" Foreground="#0E7490" Margin="0,0,0,10" />
                                        <TextBlock Text="{Binding Topic.GlossaryTerms}"
                                                   FontFamily="Calibri, Segoe UI"
                                                   FontSize="14pt"
                                                   LineHeight="26"
                                                   Foreground="#155E75"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                    </Grid>
                </Grid>
            </Border>

        </Grid>
    </Grid>
</UserControl>
